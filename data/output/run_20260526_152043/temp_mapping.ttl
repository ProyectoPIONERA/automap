	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant rdf:type;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:constant ex:Merchant;
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
