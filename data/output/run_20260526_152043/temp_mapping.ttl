		];
		rr:objectMap [
			a rr:ObjectMap;
			rml:reference "merchant";
			rr:datatype xsd:string
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant eli:has_part;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:template "http://example.com/CreditCardTransaction/{trans_num}";
			rr:termType rr:IRI
		];
	].


