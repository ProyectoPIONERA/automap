@prefix eli: <http://data.europa.eu/eli/ontology#>.
@prefix lkg: <http://example.org/lkg#>.
@prefix ex: <http://example.org/>.
@prefix schema: <http://schema.org/>.
@prefix geo1: <http://www.w3.org/2003/01/geo/wgs84_pos#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix example: <http://example.com/>.
@prefix rr: <http://www.w3.org/ns/r2rml#>.
@prefix rml: <http://semweb.mmlab.be/ns/rml#>.
@prefix ql: <http://semweb.mmlab.be/ns/ql#>.
@prefix d2rq: <http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix formats: <http://www.w3.org/ns/formats/>.
@prefix comp: <http://semweb.mmlab.be/ns/rml-compression#>.
@prefix void: <http://rdfs.org/ns/void#>.
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#>.
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#>.
@base <http://example.com/ns#>.


<CreditCardTransactionMapping_0> a rr:TriplesMap;

	rml:logicalSource [
		a rml:LogicalSource;
		rml:source "/home/naveen/Documents/LLM-Agents_RML/data/input/kaggle/Credit_Fraud/fraudTest.csv";
		rml:referenceFormulation ql:CSV

	];
	rr:subjectMap [
		a rr:SubjectMap;
		rr:template "http://example.com/CreditCardTransaction/{trans_num}";
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant rdf:type;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:constant ex:CreditCardTransaction;
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant schema:hasPart;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rml:reference "cc_num";
			rr:datatype xsd:string
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant schema:merchant;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rml:reference "merchant";
			rr:datatype xsd:string
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant ex:amount;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rml:reference "amt";
			rr:datatype xsd:decimal
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant ex:isFraud;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rml:reference "is_fraud";
			rr:datatype xsd:boolean
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant schema:cardholder;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:template "http://example.org/Person/{first}";
			rr:termType rr:IRI
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant lkg:metadata;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:template "http://example.com/CreditCardTransaction/{trans_num}/Metadata";
			rr:termType rr:IRI
		];
	].


<MerchantMapping_0> a rr:TriplesMap;

	rml:logicalSource [
